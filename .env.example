# Google AI Studio에서 발급받은 Gemini API 키 (필수)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 로그인 세션 쿠키 서명 키 (권장). 없으면 실행할 때마다 임의로 만들어져 서버를 재시작하면 모두 로그아웃된다.
# 아래 명령으로 만든 값을 넣는다:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# SQLite 파일 경로 (선택, 기본값: database.db)
# 프로젝트 루트가 아닌 곳에서 실행하면 빈 DB가 새로 생기므로 필요할 때만 지정한다.
# DB_PATH=database.db
